# Операторский env private-оценщика AR-04а. Копия: /etc/arena/private.env (вне репозитория).
# Ключи совпадают с deploy/operator.env.example арены; изменены только значения кейса.
ARENA_TRAIN_WORKSPACE=/srv/arena/train
ARENA_MLFLOW_URL=
ARENA_SPLIT=private
ARENA_SEARCH_MODE=campaign
ARENA_SEARCH_DIR=/srv/arena/search
ARENA_SEARCH_JOURNAL=/search/search.sqlite3
ARENA_SEARCH_MAX_SOLUTIONS=30
ARENA_SEARCH_CONTROL_DIR=/srv/arena/search-control
ARENA_SEARCH_STOP_PATH=/search-control/stop.json
ARENA_DATASET_PATH=/srv/arena/private/dataset.jsonl
ARENA_METRIC_PATH=/srv/arena/metric
ARENA_STATE_DIR=/srv/arena/private/state
ARENA_USAGE_DIR=/srv/arena/private/usage
ARENA_ASSETS_DIR=/srv/arena/assets
ARENA_SUBMIT_TOKEN_FILE=/srv/arena/secrets/private-submit-token
ARENA_MODEL_API_KEY_FILE=/srv/arena/secrets/model-api-key
# решатель и метрика без модели: gateway создаётся Compose, но обращений нет
ARENA_MODEL=unset
ARENA_MODEL_BASE_URL=http://internal-model.invalid/v1
ARENA_PARAMETERS={}
ARENA_RUNNER_IMAGE=ar04a-runner:local
ARENA_RUNNER_NETWORK=arena-runners
ARENA_USES_MODEL=false
ARENA_RUNNER_SUPPORTS_BUILD=false
ARENA_RUNNER_SUPPORTS_ASSET_SELECTION=false
ARENA_HARNESSES={}
ARENA_RELEASE_ID=ar04a-c1-TODO-metric-digest
ARENA_FINALISTS=5
ARENA_OUTPUT_COUNT=2
ARENA_MAX_BODY_BYTES=73400320
ARENA_MODEL_TIMEOUT=21600
# таймаут одного примера (ADR-0004)
ARENA_RUNNER_TIMEOUT=60
ARENA_PREPARE_TIMEOUT=172800
ARENA_RETRY_DELAY=30
ARENA_EVALUATOR_TIMEOUT=3600
ARENA_EVALUATOR_PORT=8080
ARENA_DOCKER_SOCKET=/var/run/docker.sock
# stat -c '%g' /var/run/docker.sock
ARENA_DOCKER_GID=1001
