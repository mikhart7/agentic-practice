# Операторский env кампании AR-04а. Копия: /etc/arena/campaign.env (вне репозитория, без секретов: токены лежат в /srv/arena/secrets).
# Используется с compose.campaign.yaml:
#   docker compose -p arena-ar04a -f case/deploy/compose.campaign.yaml --env-file /etc/arena/campaign.env up -d
ARENA_ROOT=/srv/arena
# stat -c '%g' /var/run/docker.sock
ARENA_DOCKER_GID=1001
ARENA_DOCKER_SOCKET=/var/run/docker.sock
# образ оценщика: docker compose build в ~/arena (target evaluator) или свой тег
ARENA_EVALUATOR_IMAGE=arena-evaluator:local
# версия условий: ar04a-metric-v1-runner-<первые 12 символов digest образа ar04a-runner:local без sha256:>
# (docker image inspect --format '{{.Id}}' ar04a-runner:local)
AR04A_CONDITIONS_ID=
# digest замороженного пакета метрики (python case/deploy/tree_digest.py <campaign_dir>/metric --exclude __pycache__): bc8760a07ae5...
AR04A_RELEASE_ID=ar04a-c1-metric-bc8760a07ae5
# python case/deploy/tree_digest.py /srv/arena/assets --exclude derived
AR04A_INPUT_ASSETS_DIGEST=
